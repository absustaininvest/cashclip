{
  "$schema": "https://raw.githubusercontent.com/expo/eas-cli/main/packages/eas-json/schema/eas.schema.json",
  "cli": {
    "version": ">=20.1.0",
    "appVersionSource": "local"
  },
  "build": {
    "base": {
      "node": "24.0.0"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_ENV": "development",
        "EXPO_PUBLIC_DOMAIN": "cash-clip.app"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_ENV": "preview",
        "EXPO_PUBLIC_DOMAIN": "cash-clip.app"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base",
      "environment": "production",
      "distribution": "store",
      "channel": "production",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_ENV": "production",
        "EXPO_PUBLIC_DOMAIN": "cash-clip.app",
        "SENTRY_ALLOW_FAILURE": "true",
        "SENTRY_ORG": "ab-sustainability-investments",
        "SENTRY_PROJECT": "cash-clip"
      },
      "ios": {
        "image": "latest",
        "resourceClass": "m-medium",
        "credentialsSource": "remote"
      },
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "remote"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "support@absustaininvest.com",
        "ascAppId": "6759931285",
        "appleTeamId": "FAX932PG78",
        "bundleIdentifier": "app.replit.cashclip",
        "ascApiKeyPath": "/tmp/AuthKey_4CZ93ZJV6B.p8",
        "ascApiKeyId": "4CZ93ZJV6B",
        "ascApiKeyIssuerId": "45944549-8278-4477-a1c6-3348ec45c3f0"
      },
      "android": {
        "serviceAccountKeyPath": "./credentials/google-service-account.json",
        "track": "production",
        "releaseStatus": "draft"
      }
    },
    "preview": {
      "android": {
        "serviceAccountKeyPath": "./credentials/google-service-account.json",
        "track": "internal"
      }
    }
  }
}