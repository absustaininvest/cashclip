modules = ["nodejs-20", "python-3.11", "postgresql-16"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"
integrations = ["github:1.0.0"]

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
BASE_PATH = "/"
ADMOB_APP_ID = "ca-app-pub-8679658921848348~6212139107"
EXPO_PUBLIC_DOMAIN = "cash-clip.app"
CPX_APP_ID = "32891"
PAYPAL_MODE = "live"
UNITY_ADS_GAME_ID_ANDROID = "6110341"
UNITY_ADS_GAME_ID_IOS = "6110340"
UNITY_ORGANIZATION_ID = "2475979924671"
IRONSOURCE_APP_KEY = "2690d87e5"
APPLE_ASC_KEY_ID = "4CZ93ZJV6B"

[userenv.production]

[userenv.development]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "absustain-seo-noindex"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "board-fit-tests"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "EAS iOS Build 46"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "cashclip-expo-versions"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "fuser -k 5000/tcp 2>/dev/null; sleep 1; PORT=5000 pnpm --filter @workspace/absustain run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Start Backend"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=3001 pnpm --filter @workspace/api-server run dev"
waitForPort = 3001

[[workflows.workflow]]
name = "absustain-seo-noindex"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter absustain exec vitest run src/components/Seo.test.tsx"

[[workflows.workflow]]
name = "board-fit-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter cashclip exec vitest run app/game/board-fit.test.tsx"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "EAS iOS Build 46"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash artifacts/cashclip/scripts/eas-build-ios-46.sh"

[[workflows.workflow]]
name = "cashclip-expo-versions"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/cashclip run check:versions"

[workflows.workflow.metadata]
isValidation = true

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5173
externalPort = 5173

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 22757
externalPort = 3000

[[ports]]
localPort = 25937
externalPort = 80

[[ports]]
localPort = 25938
externalPort = 3003

[deployment]
deploymentTarget = "autoscale"
run = ["node", "--enable-source-maps", "artifacts/api-server/dist/index.mjs"]
build = ["pnpm", "run", "build"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000
