modules = ["nodejs-20", "python-3.11", "postgresql-16"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"
integrations = ["github:1.0.0"]

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
BASE_PATH = "/"
ADMOB_APP_ID = "ca-app-pub-8679658921848348~6212139107"
EXPO_PUBLIC_DOMAIN = "cash-clip.app"
CPX_APP_ID = "32891"
PAYPAL_MODE = "live"
UNITY_ADS_GAME_ID_ANDROID = "6110340"
UNITY_ADS_GAME_ID_IOS = "6110341"
UNITY_ORGANIZATION_ID = "2475979924671"

[userenv.production]

[userenv.development]
APP_VISIT_PROOF_KEY = "dev-placeholder-replace-in-eas-build"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Project Video"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Chipley Publish A3"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "fuser -k 5000/tcp 2>/dev/null; sleep 1; PORT=5000 pnpm --filter @workspace/absustain run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Start Backend"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=3001 pnpm --filter @workspace/api-server run dev"
waitForPort = 3001

[[workflows.workflow]]
name = "Project Video"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5173 pnpm --filter @workspace/intro-video run dev"
waitForPort = 5173

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Chipley Publish A3"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/chipley-build/artifacts/cashclip && rm -f /tmp/chipley_publish3.log && EXPO_TOKEN=\"$EXPO_TOKLAST\" EXPO_PUBLIC_ENV=production EXPO_PUBLIC_DOMAIN=cash-clip.app EAS_NO_VCS=1 pnpm exec eas update --branch production --message \"Bigger running Chipley (harder to miss)\" --non-interactive > /tmp/chipley_publish3.log 2>&1; echo \"EAS_EXIT=$?\" >> /tmp/chipley_publish3.log"

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5173
externalPort = 5173

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 22757
externalPort = 3000

[[ports]]
localPort = 25937
externalPort = 80

[[ports]]
localPort = 25938
externalPort = 3003

[deployment]
deploymentTarget = "autoscale"
run = ["node", "--enable-source-maps", "artifacts/api-server/dist/index.mjs"]
build = ["pnpm", "run", "build"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000
