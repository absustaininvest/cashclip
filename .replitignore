# Exclude heavy, local-only files from the deployment image (8 GiB limit).
# None of these are needed to build absustain/api-server or to run the API server
# at runtime (the API serves its pre-built artifacts/api-server/dist/absustain-static).

# Grail backups / exported binaries & zips (local-only by design)
exports/

# Source uploads (screenshots, raw images) — only used as a build-time vite alias
# that absustain's source does not actually import; not needed at runtime.
attached_assets/

# Known-good restore snapshots (local-only)
snapshots/

# Agent + tooling state, caches, VCS, user config — not needed for build or runtime
.local/
.cache/
.git/
.config/
