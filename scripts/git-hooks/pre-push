#!/bin/sh
# Buffer stdin once so multiple hooks can consume it.
PUSH_INPUT=$(cat)

# --- Git LFS check ---
command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'pre-push' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks')."; exit 2; }
printf '%s\n' "$PUSH_INPUT" | git lfs pre-push "$@"
LFS_EXIT=$?
if [ "$LFS_EXIT" -ne 0 ]; then
  exit "$LFS_EXIT"
fi

# --- Version-sync check ---
# Runs check-signing-md-sync when any pushed commit touches app.json or
# SIGNING.md.  The check exits 0 immediately when SIGNING.md is absent, so
# contributors without that file are unaffected (opt-in via SIGNING.md).
#
# To opt in: create artifacts/cashclip/SIGNING.md (see SIGNING.md.template).
# To skip once: git push --no-verify

Z40=0000000000000000000000000000000000000000
NEEDS_CHECK=0

while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
  # Skip branch deletions.
  if [ "$local_sha" = "$Z40" ]; then
    continue
  fi

  if [ "$remote_sha" = "$Z40" ]; then
    # New branch: enumerate filenames from every commit not yet on any remote
    # tracking branch.  `git log --name-only --format=""` emits one filename
    # per line across all matching commits — no xargs, no per-commit loop.
    changed=$(git log --name-only --format="" "$local_sha" --not --remotes \
      2>/dev/null \
      | grep -cE '^(artifacts/cashclip/app\.json|artifacts/cashclip/SIGNING\.md)$')
  else
    # Existing branch: aggregate diff between the remote tip and local tip.
    changed=$(git diff --name-only "$remote_sha..$local_sha" 2>/dev/null \
      | grep -cE '^(artifacts/cashclip/app\.json|artifacts/cashclip/SIGNING\.md)$')
  fi

  if [ "${changed:-0}" -gt 0 ]; then
    NEEDS_CHECK=1
    break
  fi
done <<INPUT
$PUSH_INPUT
INPUT

if [ "$NEEDS_CHECK" -eq 1 ]; then
  printf '\n[pre-push] app.json or SIGNING.md changed — running version-sync check...\n'
  pnpm --filter @workspace/scripts run check-signing-md-sync
  CHECK_EXIT=$?
  if [ "$CHECK_EXIT" -ne 0 ]; then
    printf '\n[pre-push] Version-sync check failed. Fix the mismatch or use --no-verify to skip.\n'
    exit "$CHECK_EXIT"
  fi
fi

# --- Vitest config guardrail check ---
# Ensures every vitest.config.ts in the repo either imports vitest.config.base
# or explicitly sets passWithNoTests: false.  A missing guardrail lets empty
# test suites silently pass in CI.
printf '\n[pre-push] Checking vitest configs enforce no-empty-suite rule...\n'
pnpm --filter @workspace/scripts run check-vitest-configs
VITEST_CFG_EXIT=$?
if [ "$VITEST_CFG_EXIT" -ne 0 ]; then
  printf '\n[pre-push] vitest config check failed. Fix the config(s) above or use --no-verify to skip.\n'
  exit "$VITEST_CFG_EXIT"
fi

# --- TypeScript typecheck (scoped) ---
# Collect all changed files across every pushed ref, then run the minimum
# set of workspace typechecks needed.  Falls back to the full typecheck when
# root-level files, shared lib/ files, or multiple workspaces are touched.

TC_CHANGED=""
while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "$Z40" ]; then
    continue
  fi
  if [ "$remote_sha" = "$Z40" ]; then
    TC_FILES=$(git log --name-only --format="" "$local_sha" --not --remotes 2>/dev/null)
  else
    TC_FILES=$(git diff --name-only "$remote_sha..$local_sha" 2>/dev/null)
  fi
  TC_CHANGED="$TC_CHANGED
$TC_FILES"
done <<INPUT
$PUSH_INPUT
INPUT

TC_CHANGED=$(printf '%s\n' "$TC_CHANGED" | grep -v '^$' || true)

# Count touches per workspace / category (grep -c exits 1 on zero matches; use || true)
TC_API=$(printf '%s\n' "$TC_CHANGED" | grep -c '^artifacts/api-server/' || true)
TC_CASHCLIP=$(printf '%s\n' "$TC_CHANGED" | grep -c '^artifacts/cashclip/' || true)
TC_ABSUSTAIN=$(printf '%s\n' "$TC_CHANGED" | grep -c '^artifacts/absustain/' || true)
TC_SCRIPTS=$(printf '%s\n' "$TC_CHANGED" | grep -c '^scripts/' || true)
TC_LIBS=$(printf '%s\n' "$TC_CHANGED" | grep -c '^lib/' || true)
TC_ROOT=$(printf '%s\n' "$TC_CHANGED" | grep -vE '^(artifacts/|scripts/|lib/)' | grep -c '.' || true)

TC_WS_COUNT=0
[ "${TC_API:-0}" -gt 0 ] && TC_WS_COUNT=$((TC_WS_COUNT + 1))
[ "${TC_CASHCLIP:-0}" -gt 0 ] && TC_WS_COUNT=$((TC_WS_COUNT + 1))
[ "${TC_ABSUSTAIN:-0}" -gt 0 ] && TC_WS_COUNT=$((TC_WS_COUNT + 1))
[ "${TC_SCRIPTS:-0}" -gt 0 ] && TC_WS_COUNT=$((TC_WS_COUNT + 1))

if [ "${TC_ROOT:-0}" -gt 0 ] || [ "${TC_LIBS:-0}" -gt 0 ] || [ "$TC_WS_COUNT" -gt 1 ]; then
  # Shared libs, root files, or multiple workspaces changed.
  # Step 1: build shared libs serially (artifacts depend on lib build output).
  printf '\n[pre-push] Multiple workspaces or shared files changed — running TypeScript typecheck in parallel...\n'
  printf '[pre-push] (1/2) Building shared libs...\n'
  pnpm run typecheck:libs
  LIBS_EXIT=$?
  if [ "$LIBS_EXIT" -ne 0 ]; then
    printf '\n[pre-push] TypeScript typecheck failed. Fix the errors above or use --no-verify to skip.\n'
    exit "$LIBS_EXIT"
  fi

  # Step 2: determine which workspaces to check.
  # If root or lib files changed every artifact workspace is potentially affected.
  if [ "${TC_ROOT:-0}" -gt 0 ] || [ "${TC_LIBS:-0}" -gt 0 ]; then
    TC_CHECK_API=1; TC_CHECK_CASHCLIP=1; TC_CHECK_ABSUSTAIN=1; TC_CHECK_SCRIPTS=1
  else
    TC_CHECK_API="${TC_API:-0}"; TC_CHECK_CASHCLIP="${TC_CASHCLIP:-0}"
    TC_CHECK_ABSUSTAIN="${TC_ABSUSTAIN:-0}"; TC_CHECK_SCRIPTS="${TC_SCRIPTS:-0}"
  fi

  # Step 3: spawn workspace typechecks in parallel, buffer output to temp files.
  printf '[pre-push] (2/2) Type-checking workspaces in parallel...\n'
  PID_API=; PID_CASHCLIP=; PID_ABSUSTAIN=; PID_SCRIPTS=
  [ "${TC_CHECK_API:-0}"       -gt 0 ] && { pnpm --filter @workspace/api-server run typecheck >/tmp/tc-api-server.log 2>&1 & PID_API=$!; }
  [ "${TC_CHECK_CASHCLIP:-0}"  -gt 0 ] && { pnpm --filter @workspace/cashclip  run typecheck >/tmp/tc-cashclip.log  2>&1 & PID_CASHCLIP=$!; }
  [ "${TC_CHECK_ABSUSTAIN:-0}" -gt 0 ] && { pnpm --filter @workspace/absustain run typecheck >/tmp/tc-absustain.log 2>&1 & PID_ABSUSTAIN=$!; }
  [ "${TC_CHECK_SCRIPTS:-0}"   -gt 0 ] && { pnpm --filter @workspace/scripts   run typecheck >/tmp/tc-scripts.log   2>&1 & PID_SCRIPTS=$!; }

  # Background ticker: prints a heartbeat every 5 s so the terminal doesn't
  # look frozen while workers are running.  Killed once all workers finish,
  # before per-workspace result lines are printed.
  ( _tc_elapsed=0; while true; do sleep 5; _tc_elapsed=$((_tc_elapsed + 5)); printf '[pre-push] ... still type-checking (%ds)\n' "$_tc_elapsed"; done ) &
  TICKER_PID=$!

  # Wait for every spawned worker and record its exit code.
  EXIT_API=0;       [ -n "$PID_API"       ] && { wait "$PID_API";       EXIT_API=$?;       }
  EXIT_CASHCLIP=0;  [ -n "$PID_CASHCLIP"  ] && { wait "$PID_CASHCLIP";  EXIT_CASHCLIP=$?;  }
  EXIT_ABSUSTAIN=0; [ -n "$PID_ABSUSTAIN" ] && { wait "$PID_ABSUSTAIN"; EXIT_ABSUSTAIN=$?; }
  EXIT_SCRIPTS=0;   [ -n "$PID_SCRIPTS"   ] && { wait "$PID_SCRIPTS";   EXIT_SCRIPTS=$?;   }

  # All workers done — stop the ticker before printing results.
  kill "$TICKER_PID" 2>/dev/null
  wait "$TICKER_PID" 2>/dev/null

  # Print per-workspace results; show buffered output for any failures.
  TYPECHECK_EXIT=0
  for _pair in "api-server:$PID_API:$EXIT_API" "cashclip:$PID_CASHCLIP:$EXIT_CASHCLIP" "absustain:$PID_ABSUSTAIN:$EXIT_ABSUSTAIN" "scripts:$PID_SCRIPTS:$EXIT_SCRIPTS"; do
    _label="${_pair%%:*}"; _rest="${_pair#*:}"; _pid="${_rest%%:*}"; _code="${_rest##*:}"
    [ -z "$_pid" ] && continue
    printf '\n[pre-push] typecheck:%s — %s\n' "$_label" "$([ "$_code" -eq 0 ] && printf 'OK' || printf 'FAILED')"
    if [ "$_code" -ne 0 ]; then
      cat "/tmp/tc-${_label}.log"
      TYPECHECK_EXIT=1
    fi
    rm -f "/tmp/tc-${_label}.log"
  done
elif [ "$TC_WS_COUNT" -eq 1 ]; then
  # Single workspace changed — run only that workspace's typecheck.
  if [ "${TC_API:-0}" -gt 0 ]; then
    TC_FILTER="@workspace/api-server"; TC_LABEL="api-server"
  elif [ "${TC_CASHCLIP:-0}" -gt 0 ]; then
    TC_FILTER="@workspace/cashclip"; TC_LABEL="cashclip"
  elif [ "${TC_ABSUSTAIN:-0}" -gt 0 ]; then
    TC_FILTER="@workspace/absustain"; TC_LABEL="absustain"
  else
    TC_FILTER="@workspace/scripts"; TC_LABEL="scripts"
  fi
  printf '\n[pre-push] Only %s changed — running scoped TypeScript typecheck...\n' "$TC_LABEL"
  pnpm --filter "$TC_FILTER" run typecheck
  TYPECHECK_EXIT=$?
else
  printf '\n[pre-push] No TypeScript workspace files changed — skipping typecheck.\n'
  TYPECHECK_EXIT=0
fi

if [ "$TYPECHECK_EXIT" -ne 0 ]; then
  printf '\n[pre-push] TypeScript typecheck failed. Fix the errors above or use --no-verify to skip.\n'
  exit "$TYPECHECK_EXIT"
fi

exit 0
